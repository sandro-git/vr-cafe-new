---
import BaseHead from "./BaseHead.astro";
const PUBLIC_VAPID_KEY = import.meta.env.PUBLIC_VAPID_KEY ?? "";

const pathname = Astro.url.pathname;
const navLinks = [
  { href: "/admin/reservations", label: "Réservations" },
  { href: "/admin/planning", label: "Planning" },
  { href: "/admin/clients", label: "Clients" },
  { href: "/admin/bons", label: "Bons cadeaux" },
  { href: "/admin/avis", label: "Avis" },
  { href: "/admin/marketing", label: "Marketing" },
  { href: "/admin/aide", label: "Aide" },
];
const isActive = (href: string) =>
  pathname === href || pathname.startsWith(href + "/");
---

<html lang="fr" class="smooth scroll-smooth dark">
  <BaseHead />
  <body class="bg-[var(--color-surface)] text-[var(--color-text-base)] min-h-screen">
    <header
      class="fixed top-0 inset-x-0 z-50 h-14 bg-[var(--color-surface-elevated)]/90 backdrop-blur-xl border-b border-white/10"
    >
      <div class="h-full max-w-7xl mx-auto px-3 sm:px-4 flex items-center gap-2 sm:gap-4">
        <a
          href="/admin/reservations"
          class="hidden sm:flex items-center gap-2 shrink-0 font-display font-bold tracking-tight"
        >
          <span class="text-[var(--color-brand-400)]">VR Café</span>
          <span class="text-white/30 font-normal">·</span>
          <span class="text-white/60 font-normal text-sm">Admin</span>
        </a>

        <nav class="flex-1 flex items-center gap-1 overflow-x-auto no-scrollbar">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class:list={[
                  "shrink-0 px-3 py-1.5 rounded-lg text-sm font-medium transition-colors",
                  isActive(link.href)
                    ? "bg-white/10 text-white"
                    : "text-white/55 hover:text-white hover:bg-white/5",
                ]}
              >
                {link.label}
              </a>
            ))
          }
        </nav>

        <a
          href="/admin/reservation"
          class="shrink-0 inline-flex items-center gap-1 px-3 sm:px-4 py-1.5 bg-[var(--color-brand-600)] hover:bg-[var(--color-brand-500)] text-white font-semibold rounded-lg text-sm transition-colors"
        >
          <span class="text-base leading-none">+</span>
          <span>Réserver</span>
        </a>

        <form id="admin-logout" method="post" action="/admin/logout" class="shrink-0">
          <button
            type="submit"
            title="Se déconnecter de cet appareil"
            aria-label="Déconnexion"
            class="inline-flex items-center gap-1.5 px-2 sm:px-3 py-1.5 rounded-lg text-sm font-medium text-white/55 hover:text-white hover:bg-white/5 transition-colors"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg>
            <span class="hidden md:inline">Déconnexion</span>
          </button>
        </form>
      </div>
    </header>

    <div class="pt-14">
      <slot />
    </div>

    <style>
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </body>
</html>

<script define:vars={{ PUBLIC_VAPID_KEY }}>
  if ("serviceWorker" in navigator && "PushManager" in window && PUBLIC_VAPID_KEY) {
    navigator.serviceWorker.register("/sw.js").then(async (registration) => {
      const permission = await Notification.requestPermission();
      if (permission !== "granted") return;

      // Abonnement existant renvoyé aussi (upsert idempotent) : si sa ligne a disparu de
      // push_subscriptions (suppression manuelle, purge), l'appareil est ré-enregistré.
      const sub =
        (await registration.pushManager.getSubscription()) ??
        (await registration.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: PUBLIC_VAPID_KEY,
        }));

      await fetch("/api/push/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(sub.toJSON()),
      }).catch(() => {});
    }).catch(() => {});
  }

  // Déconnexion : l'appareil cesse de recevoir les notifications admin. Le navigateur se
  // désabonne d'abord (l'endpoint devient invalide : même si la suppression serveur échoue,
  // push-notify purgera la ligne au prochain envoi, erreur 410), puis la ligne est supprimée
  // tant que la session est encore valide. Jamais bloquant : au bout de 2 s on déconnecte quand même.
  const logoutForm = document.getElementById("admin-logout");
  if (logoutForm && !logoutForm.dataset.bound) {
    logoutForm.dataset.bound = "true";
    logoutForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (logoutForm.dataset.pending) return;
      logoutForm.dataset.pending = "true";

      const unsubscribe = async () => {
        if (!("serviceWorker" in navigator)) return;
        const registration = await navigator.serviceWorker.getRegistration();
        const sub = await registration?.pushManager.getSubscription();
        if (!sub) return;
        const { endpoint } = sub;
        if (!(await sub.unsubscribe())) return;
        await fetch("/api/push/subscribe", {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ endpoint }),
          keepalive: true,
        });
      };

      try {
        await Promise.race([unsubscribe(), new Promise((r) => setTimeout(r, 2000))]);
      } catch {
        // désabonnement impossible : la déconnexion a lieu quand même
      }
      logoutForm.submit();
    });
  }
</script>
