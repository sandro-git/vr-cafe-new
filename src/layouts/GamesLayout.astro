---
import PageHeader from "../components/PageHeader.astro";

interface Props {
  eyebrow?: string;
  title: string;
  highlight: string;
  subtitle: string;
}

const { eyebrow = "Catalogue", title, highlight, subtitle } = Astro.props;

const GAMEPAD_ICON = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M7 12h2m-1-1v2m6-1h.01M17 12h.01M5 7h14a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2V9a2 2 0 012-2z"/>`;
const LOCK_ICON = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 11V7a4 4 0 118 0v4m-9 0h10a2 2 0 012 2v6a2 2 0 01-2 2H11a2 2 0 01-2-2v-6a2 2 0 012-2z"/>`;
const PLUG_ICON = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 9V5a1 1 0 0 1 1-1h1a1 1 0 0 1 1 1v4"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 9V5a1 1 0 0 1 1-1h1a1 1 0 0 1 1 1v4"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 9h16v3a6 6 0 0 1-6 6H10a6 6 0 0 1-6-6V9Z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 18v3"/>`;
const WIFI_ICON = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M5 13a10 10 0 0 1 14 0"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8.5 16.5a5 5 0 0 1 7 0"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 20h.01"/>`;

const familleOptions = [
  { value: "all", label: "Tous", icon: null },
  { value: "jeuxVR", label: "Jeux VR", icon: GAMEPAD_ICON },
  { value: "escapeGame", label: "Escape Games", icon: LOCK_ICON },
];

const modeOptions = [
  { value: "all", label: "Tous", icon: null },
  { value: "filaire", label: "Filaire", icon: PLUG_ICON },
  { value: "sans_fil", label: "Sans fil", icon: WIFI_ICON },
];

const labelClass = "text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-brand-400)]";

const pillClass = (active: boolean) =>
  [
    "inline-flex items-center gap-1.5 rounded-full px-5 py-2 text-sm font-medium tracking-tight transition-all duration-[var(--dur-fast)] ring-1",
    active
      ? "text-white bg-[var(--color-brand-500)] ring-[var(--color-brand-400)] shadow-[0_8px_24px_-8px_rgba(139,92,246,0.55)]"
      : "text-white/70 bg-white/[0.06] ring-white/15 hover:text-white hover:bg-white/10 hover:ring-white/25",
  ].join(" ");
---

<section class="bg-[var(--color-surface)]">
  <div class="flex flex-col items-center">
    <PageHeader eyebrow={eyebrow} title={title} highlight={highlight} subtitle={subtitle} />
  </div>

  <!-- Filtres famille + mode (JS côté client, aucun rechargement de page) -->
  <div id="catalogue-filters" class="reveal flex flex-col items-center gap-4 mb-10 px-4">
    <div class="flex flex-col items-center gap-2">
      <span class={labelClass}>Type</span>
      <ul class="flex flex-wrap gap-2 justify-center" data-filter-group="famille">
        {familleOptions.map((opt) => (
          <li>
            <button type="button" data-filter-value={opt.value} class={pillClass(opt.value === "all")}>
              {opt.icon && (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" set:html={opt.icon} />
              )}
              {opt.label}
            </button>
          </li>
        ))}
      </ul>
    </div>
    <div class="flex flex-col items-center gap-2">
      <span class={labelClass}>Mode</span>
      <ul class="flex flex-wrap gap-2 justify-center" data-filter-group="mode">
        {modeOptions.map((opt) => (
          <li>
            <button type="button" data-filter-value={opt.value} class={pillClass(opt.value === "all")}>
              {opt.icon && (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" set:html={opt.icon} />
              )}
              {opt.label}
            </button>
          </li>
        ))}
      </ul>
    </div>
    <p id="catalogue-filters-empty" class="hidden text-sm text-white/55 mt-2">
      Aucune expérience ne correspond à ces filtres.
    </p>
  </div>

  <div class="pb-20 lg:pb-28">
    <slot />
  </div>
</section>

<script>
  const ACTIVE_CLASSES = [
    "text-white",
    "bg-[var(--color-brand-500)]",
    "ring-[var(--color-brand-400)]",
    "shadow-[0_8px_24px_-8px_rgba(139,92,246,0.55)]",
  ];
  const INACTIVE_CLASSES = ["text-white/70", "bg-white/[0.06]", "ring-white/15"];
  const STORAGE_KEY = "vrcafe:catalogue-filters";
  const CATALOGUE_PATH = /^\/experiences-vr\/?$/;

  interface FilterState {
    famille: string;
    mode: string;
  }

  interface AstroBeforeSwapEvent extends Event {
    to: URL;
    newDocument: Document;
  }

  function readPersistedFilters(): Partial<FilterState> | null {
    try {
      const raw = sessionStorage.getItem(STORAGE_KEY);
      return raw ? (JSON.parse(raw) as Partial<FilterState>) : null;
    } catch {
      return null;
    }
  }

  function persistFilters(state: FilterState) {
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch {
      // sessionStorage indisponible : on continue simplement sans persistance
    }
  }

  // Priorité : query params (liens externes/partagés) > dernier choix de l'onglet > défaut.
  function resolveFilterState(url: URL): FilterState {
    const state: FilterState = { famille: "all", mode: "all" };

    const persisted = readPersistedFilters();
    if (persisted?.famille) state.famille = persisted.famille;
    if (persisted?.mode) state.mode = persisted.mode;

    const params = new URLSearchParams(url.search);
    const familleParam = params.get("famille");
    const modeParam = params.get("mode");
    if (familleParam === "jeux") state.famille = "jeuxVR";
    if (familleParam === "escape") state.famille = "escapeGame";
    if (modeParam === "sans-fil") state.mode = "sans_fil";
    if (modeParam === "filaire") state.mode = "filaire";

    return state;
  }

  // Applique l'état de filtre à un document donné (le document courant, ou le document
  // entrant d'une navigation astro:before-swap, avant que le swap réel n'ait eu lieu).
  function applyFilterState(doc: Document, state: FilterState) {
    const root = doc.getElementById("catalogue-filters");
    root?.querySelectorAll<HTMLElement>("[data-filter-group]").forEach((group) => {
      const groupName = group.dataset.filterGroup as keyof FilterState;
      group.querySelectorAll<HTMLButtonElement>("button[data-filter-value]").forEach((btn) => {
        const active = btn.dataset.filterValue === state[groupName];
        btn.classList.toggle(ACTIVE_CLASSES[0], active);
        btn.classList.toggle(ACTIVE_CLASSES[1], active);
        btn.classList.toggle(ACTIVE_CLASSES[2], active);
        btn.classList.toggle(ACTIVE_CLASSES[3], active);
        btn.classList.toggle(INACTIVE_CLASSES[0], !active);
        btn.classList.toggle(INACTIVE_CLASSES[1], !active);
        btn.classList.toggle(INACTIVE_CLASSES[2], !active);
      });
    });

    const cards = doc.querySelectorAll<HTMLElement>("[data-family][data-headset]");
    let visibleCount = 0;
    cards.forEach((card) => {
      const familyMatch = state.famille === "all" || card.dataset.family === state.famille;
      const modeMatch = state.mode === "all" || card.dataset.headset === state.mode;
      const visible = familyMatch && modeMatch;
      card.classList.toggle("hidden", !visible);
      if (visible) visibleCount++;
    });
    doc.getElementById("catalogue-filters-empty")?.classList.toggle("hidden", visibleCount > 0);
  }

  function initCatalogueFilters() {
    const root = document.getElementById("catalogue-filters");
    if (!root || root.dataset.filtersBound === "1") return;
    root.dataset.filtersBound = "1";

    const state = resolveFilterState(new URL(window.location.href));
    applyFilterState(document, state);

    root.querySelectorAll<HTMLElement>("[data-filter-group]").forEach((group) => {
      const groupName = group.dataset.filterGroup as keyof FilterState;
      group.querySelectorAll<HTMLButtonElement>("button[data-filter-value]").forEach((btn) => {
        btn.addEventListener("click", () => {
          state[groupName] = btn.dataset.filterValue!;
          persistFilters(state);
          applyFilterState(document, state);
        });
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCatalogueFilters);
  } else {
    initCatalogueFilters();
  }
  document.addEventListener("astro:page-load", initCatalogueFilters);

  // Pré-applique les filtres persistés au document entrant AVANT qu'Astro ne restaure le
  // scroll d'une navigation retour/avant (sinon la restauration se fait sur une page non
  // filtrée donc plus haute, et le scroll retombe au mauvais endroit une fois filtrée).
  // Enregistré une seule fois pour toute la session : `document` persiste entre les
  // navigations View Transitions, donc ce listener reste actif même une fois quitté
  // /experiences-vr (ex. sur la fiche d'un jeu), prêt à intercepter le retour arrière.
  const win = window as typeof window & { __catalogueBeforeSwapBound?: boolean };
  if (!win.__catalogueBeforeSwapBound) {
    win.__catalogueBeforeSwapBound = true;
    document.addEventListener("astro:before-swap", (event) => {
      const swapEvent = event as AstroBeforeSwapEvent;
      if (!CATALOGUE_PATH.test(swapEvent.to.pathname)) return;
      applyFilterState(swapEvent.newDocument, resolveFilterState(swapEvent.to));
    });
  }
</script>
