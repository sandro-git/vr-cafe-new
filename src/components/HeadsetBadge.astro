---
import { HEADSET_LABELS, type HeadsetType } from "../lib/headsetBadge";

interface Props {
  type: HeadsetType;
  size?: "sm" | "md";
  variant?: "pill" | "icon";
  class?: string;
}

const { type, size = "sm", variant = "pill", class: className } = Astro.props;

const sizeClasses =
  size === "md" ? "px-3 py-1.5 text-xs gap-1.5" : "px-2.5 py-1 text-[11px] gap-1";

const iconSize = variant === "icon" ? 18 : 12;
---

{
  variant === "icon" ? (
    <span
      class:list={[
        "inline-flex items-center justify-center w-9 h-9 rounded-full backdrop-blur-md ring-1 text-white bg-[var(--color-glow-cyan)]/30 ring-[var(--color-glow-cyan)]/50",
        className,
      ]}
      aria-label={HEADSET_LABELS[type]}
      title={HEADSET_LABELS[type]}
    >
      {type === "filaire" ? (
        <svg width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 9V5a1 1 0 0 1 1-1h1a1 1 0 0 1 1 1v4" />
          <path d="M17 9V5a1 1 0 0 1 1-1h1a1 1 0 0 1 1 1v4" />
          <path d="M4 9h16v3a6 6 0 0 1-6 6H10a6 6 0 0 1-6-6V9Z" />
          <path d="M12 18v3" />
        </svg>
      ) : (
        <svg width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 13a10 10 0 0 1 14 0" />
          <path d="M8.5 16.5a5 5 0 0 1 7 0" />
          <path d="M12 20h.01" />
        </svg>
      )}
    </span>
  ) : (
    <span
      class:list={[
        "inline-flex items-center rounded-full bg-black/40 backdrop-blur-md ring-1 ring-white/15 font-semibold uppercase tracking-wide text-white",
        sizeClasses,
        className,
      ]}
    >
      {type === "filaire" ? (
        <svg width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 9V5a1 1 0 0 1 1-1h1a1 1 0 0 1 1 1v4" />
          <path d="M17 9V5a1 1 0 0 1 1-1h1a1 1 0 0 1 1 1v4" />
          <path d="M4 9h16v3a6 6 0 0 1-6 6H10a6 6 0 0 1-6-6V9Z" />
          <path d="M12 18v3" />
        </svg>
      ) : (
        <svg width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 13a10 10 0 0 1 14 0" />
          <path d="M8.5 16.5a5 5 0 0 1 7 0" />
          <path d="M12 20h.01" />
        </svg>
      )}
      {HEADSET_LABELS[type]}
    </span>
  )
}
