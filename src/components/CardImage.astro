---
// src/components/CardImage.astro
import SanityPicture from "./SanityPicture.astro";
import Play from "./Play.astro";
import HeadsetBadge from "./HeadsetBadge.astro";

const { image, alt, slug, title, category, headsetType, players, duration, loading, fetchpriority } = Astro.props;

// Mappe le slug de catégorie (famille) vers un label lisible (accessibilité)
const CATEGORY_LABELS: Record<string, string> = {
  jeuxVR: "Jeu VR",
  escapeGame: "Escape Game",
};
const categoryLabel = category ? CATEGORY_LABELS[category] ?? category : null;

// Construit la ligne méta (joueurs · durée), chaque partie conditionnelle
// Normalise une durée purement numérique en "<n> min"
const durationLabel = duration
  ? /^\d+$/.test(String(duration).trim())
    ? `${String(duration).trim()} min`
    : String(duration)
  : null;

const metaParts: string[] = [];
if (players) metaParts.push(`${players} joueurs`);
if (durationLabel) metaParts.push(durationLabel);
const meta = metaParts.join(" · ");
---

<a
  href={"/" + slug}
  class="block w-full relative overflow-hidden rounded-[var(--radius-card)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--color-brand-400)]"
>
  <SanityPicture
    image={image}
    alt={alt}
    className="!rounded-none transition-transform duration-[var(--dur-slow)] ease-[var(--ease-out-soft)] group-hover:scale-105"
    loading={loading}
    fetchpriority={fetchpriority}
  />

  <!-- Dégradé : sombre en bas, léger voile en haut pour les badges -->
  <div
    class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/15 to-black/40 pointer-events-none"
  ></div>

  <!-- Badge catégorie (icône + texte) -->
  {category && (
    <span
      class="absolute top-3 left-3 z-10 inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide backdrop-blur-md ring-1 text-white bg-[var(--color-brand-500)]/35 ring-[var(--color-brand-400)]/50"
    >
      {category === "escapeGame" ? (
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 11V7a4 4 0 118 0v4m-9 0h10a2 2 0 012 2v6a2 2 0 01-2 2H11a2 2 0 01-2-2v-6a2 2 0 012-2z" />
        </svg>
      ) : (
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 12h2m-1-1v2m6-1h.01M17 12h.01M5 7h14a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2V9a2 2 0 012-2z" />
        </svg>
      )}
      {categoryLabel}
    </span>
  )}

  <!-- Badge type de casque (icône + texte) -->
  {headsetType && (
    <HeadsetBadge type={headsetType} variant="pill" tone="cyan" class="absolute top-3 right-3 z-10" />
  )}

  <!-- Bas : titre + méta + play -->
  <div class="absolute inset-x-0 bottom-0 z-10 flex items-end justify-between gap-3 p-4">
    <div class="min-w-0">
      <h3 class="text-lg font-semibold text-white drop-shadow-lg leading-tight line-clamp-2">
        {title || alt}
      </h3>
      {meta && (
        <p class="mt-0.5 text-sm text-white/80 drop-shadow-md truncate">{meta}</p>
      )}
    </div>
    <span
      class="shrink-0 inline-flex items-center justify-center w-10 h-10 rounded-full bg-white/15 ring-1 ring-white/25 backdrop-blur-md text-white transition-transform duration-[var(--dur-base)] ease-[var(--ease-out-soft)] group-hover:scale-110"
    >
      <Play class="drop-shadow-lg" />
    </span>
  </div>
</a>
