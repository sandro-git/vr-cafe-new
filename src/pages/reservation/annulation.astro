---
// Page statique : la réservation (?id=&token= du lien de l'email) est chargée
// côté client via /api/reservation-lookup-public, pour ne pas dépendre du
// démarrage à froid d'une fonction au chargement de la page.
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
---

<BaseLayout
  title="Annuler ma réservation — VR Café"
  description="Annulez ou reprogrammez votre réservation VR Café en ligne."
  canonical="https://vr-cafe.fr/reservation/annulation"
>
  <section class="bg-[var(--color-surface)] py-16 md:py-24 min-h-[calc(100vh-var(--navHeight))] flex items-center px-4">
    <div class="mx-auto max-w-xl w-full">
      <div class="reveal card-glow p-8 md:p-10">
        <div data-state="loading" class="text-center py-8" role="status">
          <div class="mx-auto mb-4 h-8 w-8 animate-spin rounded-full border-2 border-white/15 border-t-[var(--color-brand-400)]"></div>
          <p class="text-white/70">Chargement de votre réservation…</p>
        </div>

        <div data-state="invalid" class="hidden text-center">
          <h1 class="mb-4 font-display text-3xl font-extrabold tracking-tight text-white">
            Lien invalide
          </h1>
          <p class="mb-8 text-white/70">
            Ce lien d'annulation est invalide ou a expiré. Contactez-nous directement pour toute demande.
          </p>
          <Button href="tel:0671410695" variant="primary" size="md">📞 06 71 41 06 95</Button>
        </div>

        <div data-state="cancelled" class="hidden text-center">
          <h1 class="mb-4 font-display text-3xl font-extrabold tracking-tight text-white">
            Déjà annulée
          </h1>
          <p class="mb-8 text-white/70">Cette réservation a déjà été annulée.</p>
          <Button href="/reservation" variant="primary" size="md">Faire une nouvelle réservation</Button>
        </div>

        <div data-state="too-late" class="hidden text-center">
          <h1 class="mb-4 font-display text-3xl font-extrabold tracking-tight text-white">
            Délai dépassé
          </h1>
          <p class="mb-8 text-white/70">
            L'annulation en ligne n'est plus possible à moins de 24h du créneau. Merci de nous contacter directement.
          </p>
          <Button href="tel:0671410695" variant="primary" size="md">📞 06 71 41 06 95</Button>
        </div>

        <div data-state="confirm" class="hidden">
          <h1 class="mb-2 font-display text-3xl font-extrabold tracking-tight text-white">
            <span data-modifier-text="Reprogrammer">Annuler</span> ma réservation
          </h1>
          <p class="mb-6 text-white/70" data-modifier-text="Choisissez votre nouveau créneau : votre réservation actuelle reste valable et ne sera annulée qu'une fois le nouveau créneau confirmé.">
            Merci de confirmer l'annulation de votre réservation ci-dessous.
          </p>

          <div class="bg-white/5 ring-1 ring-white/10 rounded-xl p-6 mb-8 space-y-3">
            <div class="flex justify-between"><span class="text-white/55">Nom</span><span class="text-white" data-field="nom"></span></div>
            <div class="flex justify-between"><span class="text-white/55">Date</span><span class="text-white" data-field="date"></span></div>
            <div class="flex justify-between"><span class="text-white/55">Heure</span><span class="text-white" data-field="heure"></span></div>
            <div class="flex justify-between"><span class="text-white/55">Joueurs</span><span class="text-white" data-field="joueurs"></span></div>
          </div>

          <div id="annulation-error" class="hidden mb-6 rounded-xl bg-red-500/10 border border-red-500/30 px-4 py-3 text-sm text-red-300" role="alert"></div>

          <div class="flex flex-col sm:flex-row gap-4">
            <button
              id="btn-confirm-cancel"
              type="button"
              data-modifier-text="Choisir un nouveau créneau"
              class="group relative inline-flex items-center justify-center gap-2 font-semibold tracking-tight rounded-full transition-all duration-[var(--dur-base)] ease-[var(--ease-out-soft)] focus:outline-none px-6 py-3 text-base bg-white text-brand-900 hover:bg-accent-300 hover:-translate-y-0.5 shadow-[0_10px_40px_-10px_rgba(139,92,246,0.6)] w-full disabled:opacity-50"
            >
              Confirmer l'annulation
            </button>
            <Button href="/" variant="secondary" size="md" class="w-full">Retour</Button>
          </div>
        </div>

        <div data-state="success" class="hidden text-center">
          <h1 class="mb-4 font-display text-3xl font-extrabold tracking-tight text-white">
            Réservation annulée
          </h1>
          <p class="mb-8 text-white/70">
            Votre réservation a bien été annulée. À bientôt au VR Café !
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  type Lookup = {
    ok: boolean;
    reservation?: {
      client_nom: string;
      client_email: string | null;
      client_telephone: string;
      nb_personnes: number;
      creneau_debut: string;
      creneau_fin: string;
    };
    can_cancel?: boolean;
    already_cancelled?: boolean;
  };

  const TZ = "Europe/Paris";

  function showState(root: HTMLElement, state: string) {
    root.querySelectorAll<HTMLElement>("[data-state]").forEach((el) => {
      el.classList.toggle("hidden", el.dataset.state !== state);
    });
  }

  async function initAnnulation() {
    const root = document.querySelector<HTMLElement>("[data-state='loading']")?.parentElement;
    if (!root || root.dataset.annulationBound) return;
    root.dataset.annulationBound = "true";

    const params = new URLSearchParams(window.location.search);
    const id = params.get("id") ?? "";
    const token = params.get("token") ?? "";
    const isModifier = params.get("action") === "modifier";

    if (isModifier) {
      root.querySelectorAll<HTMLElement>("[data-modifier-text]").forEach((el) => {
        el.textContent = el.dataset.modifierText!;
      });
    }

    let lookup: Lookup | null = null;
    if (id && token) {
      try {
        const res = await fetch(`/api/reservation-lookup-public?${new URLSearchParams({ id, token })}`);
        if (res.ok) lookup = await res.json();
      } catch {
        lookup = null;
      }
    }

    const r = lookup?.reservation;
    if (!lookup?.ok || !r) return showState(root, "invalid");
    if (lookup.already_cancelled) return showState(root, "cancelled");
    if (!lookup.can_cancel) return showState(root, "too-late");

    const debut = new Date(r.creneau_debut);
    const fin = new Date(r.creneau_fin);
    const heure = (d: Date) => d.toLocaleTimeString("fr-FR", { hour: "2-digit", minute: "2-digit", timeZone: TZ });
    const fields: Record<string, string> = {
      nom: r.client_nom,
      date: debut.toLocaleDateString("fr-FR", { weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: TZ }),
      heure: `${heure(debut)} – ${heure(fin)}`,
      joueurs: String(r.nb_personnes),
    };
    root.querySelectorAll<HTMLElement>("[data-field]").forEach((el) => {
      el.textContent = fields[el.dataset.field!] ?? "";
    });
    showState(root, "confirm");

    const btn = root.querySelector<HTMLButtonElement>("#btn-confirm-cancel")!;
    const errorEl = root.querySelector<HTMLElement>("#annulation-error");
    btn.addEventListener("click", async () => {
      // Modification : on n'annule rien ici. Le formulaire annulera l'ancienne
      // réservation seulement après confirmation du nouveau créneau.
      if (isModifier) {
        const next = new URLSearchParams({ nom: r.client_nom, email: r.client_email ?? "", telephone: r.client_telephone, remplace: id, token });
        window.location.href = `/reservation?${next.toString()}`;
        return;
      }

      errorEl?.classList.add("hidden");
      btn.disabled = true;

      try {
        const res = await fetch("/api/reservation-cancel-public", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id, token }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Une erreur est survenue.");

        showState(root, "success");
      } catch (err) {
        if (errorEl) {
          errorEl.textContent = err instanceof Error ? err.message : "Une erreur est survenue.";
          errorEl.classList.remove("hidden");
        }
        btn.disabled = false;
      }
    });
  }

  initAnnulation();
  document.addEventListener("astro:page-load", initAnnulation);
</script>
