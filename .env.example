# Google Analytics 4
PUBLIC_GA_ID=G-XXXXXXXXXX

# Mailjet Configuration
# Required for contact form functionality
# Get your API credentials from: https://app.mailjet.com/account/apikeys

MAILJET_API_KEY=your_mailjet_api_key_here
MAILJET_API_SECRET=your_mailjet_api_secret_here
MAILJET_SENDER_EMAIL=contact@vr-cafe.fr

# Sanity CMS (already configured)
PUBLIC_SANITY_PROJECT_ID=0oshw5tf
PUBLIC_SANITY_DATASET=production

# Supabase
PUBLIC_SUPABASE_URL=your_supabase_url_here
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key — NE JAMAIS exposer côté client, uniquement dans les fonctions serveur
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Anthropic — génération des brouillons de réponse aux avis Google (/admin/avis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Business Profile — publication des réponses aux avis (/admin/avis)
# Prérequis : accès API Business Profile approuvé par Google + refresh_token
# obtenu manuellement (scope business.manage). Voir le plan d'implémentation
# pour la procédure complète.
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token_here
GBP_ACCOUNT_ID=your_google_business_profile_account_id_here
GBP_LOCATION_ID=your_google_business_profile_location_id_here
